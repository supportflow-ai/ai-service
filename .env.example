SUPPORTFLOW_AI_ENVIRONMENT=development
SUPPORTFLOW_AI_AUTH_ENABLED=true
# Replace with a randomly generated token of at least 32 characters.
# No default credential is shipped.
SUPPORTFLOW_AI_SERVICE_TOKEN=
SUPPORTFLOW_AI_CLASSIFIER_PROVIDER=rule
SUPPORTFLOW_AI_EMBEDDING_PROVIDER=noop
# Chọn local-e5 sau khi đã tải model ghim revision; image embeddings dùng /opt/models.
SUPPORTFLOW_AI_EMBEDDING_CACHE_DIR=
SUPPORTFLOW_AI_LOG_LEVEL=INFO
SUPPORTFLOW_AI_MAX_REQUEST_BYTES=65536
